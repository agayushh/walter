DATABASE_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Signing secret for the Clerk webhook at /api/webhooks/clerk
WEBHOOK_SECRET=

# groq | gemini | ollama (alias: local). The in-app switcher can override per browser.
LLM_PROVIDER=groq

GROQ_API_KEY=
# Must be a model your key can use: https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b
# Speech-to-text for browsers without the Web Speech API (uses GROQ_API_KEY)
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local models: `ollama pull llama3.2`, then LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
